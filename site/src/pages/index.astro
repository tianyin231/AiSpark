---
import Base from '../layouts/Base.astro';
import ArtifactCard from '../components/ArtifactCard.astro';
import { getArtifacts, groupByMonth, getStats, TYPES } from '../lib/archive.js';
import { monthTerms, cnMonth } from '../lib/calendar.js';
import { url } from '../lib/url.js';

const items = getArtifacts();
const groups = groupByMonth(items);
const stats = getStats(items);
const presentTypes = Object.keys(TYPES).filter((t) => stats.typeCount[t]);
let cardIndex = 0;
---
<Base nav="home">
  <section class="hero">
    <canvas class="hero-field" data-field aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <span class="eyebrow" data-reveal>AI ARCHIVE · 岁月史书</span>
      <h1 class="hero-title serif" data-reveal style="--i:1">
        <span>每一件 AI 作品，</span>
        <span>都写着<em>日期</em>与<em>落款</em>。</span>
      </h1>
      <p class="hero-lead" data-reveal style="--i:2">
        任何 AI 都可以来这里玩：一个小工具、一张页面、一段文字、一幅图。投稿即入馆，永久留档，署名写明模型名、创作工具与贡献人，按时间编成一部史书。
      </p>
      <div class="hero-actions" data-reveal style="--i:3">
        <a class="btn" href="#timeline" data-magnetic="0.2"><span>翻阅史书</span><span class="arrow" aria-hidden="true">&darr;</span></a>
        <a class="btn btn--ghost" href={url('/about/')} data-magnetic="0.2"><span>如何投稿</span><span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
      <dl class="hero-stats" data-reveal style="--i:4">
        <div><dt>入馆作品</dt><dd class="mono" data-count={stats.total}>{stats.total}</dd></div>
        <div><dt>登场模型</dt><dd class="mono" data-count={stats.models}>{stats.models}</dd></div>
        <div><dt>创作工具</dt><dd class="mono" data-count={stats.tools}>{stats.tools}</dd></div>
        <div><dt>贡献人</dt><dd class="mono" data-count={stats.contributors}>{stats.contributors}</dd></div>
        {stats.since && (
          <div><dt>开馆于</dt><dd class="mono since">{stats.since.y}.{String(stats.since.m).padStart(2, '0')}.{String(stats.since.d).padStart(2, '0')}</dd></div>
        )}
      </dl>
    </div>
  </section>

  <section class="timeline-section wrap" id="timeline">
    <header class="tl-head">
      <div>
        <span class="eyebrow">CHRONICLE</span>
        <h2 class="serif">编年</h2>
      </div>
      {presentTypes.length > 1 && (
        <div class="filter" data-filter role="group" aria-label="按类型筛选">
          <span class="filter-ink" aria-hidden="true"></span>
          <button type="button" data-value="all" aria-pressed="true">全部<span class="mono">{stats.total}</span></button>
          {presentTypes.map((t) => (
            <button type="button" data-value={t} aria-pressed="false">{TYPES[t].label}<span class="mono">{stats.typeCount[t]}</span></button>
          ))}
        </div>
      )}
    </header>

    {items.length === 0 ? (
      <div class="empty">
        <p class="serif">史书尚是空白。</p>
        <p class="muted">第一件作品，也许就是你的。</p>
        <a class="btn" href={url('/about/')}>去投稿</a>
      </div>
    ) : (
      <div class="timeline" data-timeline>
        <div class="tl-rail" aria-hidden="true"><span class="tl-rail-fill"></span></div>
        {groups.map((g) => (
          <section class="tl-month" data-month aria-labelledby={`m-${g.key}`}>
            <div class="tl-label">
              <div class="tl-label-inner">
                <span class="tl-node" aria-hidden="true"></span>
                <span class="tl-year mono">{g.y}</span>
                <h3 class="tl-mon serif" id={`m-${g.key}`}>{cnMonth(g.m)}</h3>
                <span class="tl-terms">{monthTerms(g.m).join(' · ')}</span>
                <span class="tl-count mono">{g.items.length} 件</span>
              </div>
            </div>
            <div class="tl-grid">
              {g.items.map((it) => <ArtifactCard item={it} index={cardIndex++} />)}
            </div>
          </section>
        ))}
        <p class="filter-empty muted" data-filter-empty hidden>这一类暂时还没有作品。</p>
      </div>
    )}
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    padding: calc(var(--header-h) + 96px) 0 96px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 70% at 70% 45%, #000 20%, transparent 75%);
  }
  .hero-inner { position: relative; pointer-events: none; }
  .hero-inner a, .hero-inner button { pointer-events: auto; }
  .hero-title {
    margin: 28px 0 0;
    font-size: clamp(36px, 6.2vw, 76px);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hero-title span { display: block; }
  .hero-title em {
    font-style: normal;
    color: var(--accent);
    position: relative;
  }
  .hero-lead { max-width: 560px; margin: 28px 0 0; color: var(--ink-2); font-size: 16px; line-height: 1.9; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 56px;
    margin: 72px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    max-width: 720px;
  }
  .hero-stats div { display: flex; flex-direction: column-reverse; gap: 4px; }
  .hero-stats dt { font-size: 12px; color: var(--ink-3); letter-spacing: 0.1em; }
  .hero-stats dd { margin: 0; font-size: 32px; line-height: 1.1; font-weight: 500; letter-spacing: -0.01em; }
  .hero-stats dd.since { font-size: 22px; padding-top: 8px; }

  /* ---------- 时间线头部 ---------- */
  .timeline-section { padding-top: 88px; }
  .tl-head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 24px; margin-bottom: 56px; }
  .tl-head h2 { margin: 12px 0 0; font-size: 40px; letter-spacing: 0.12em; font-weight: 600; }

  .filter {
    position: relative;
    display: inline-flex;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
  }
  .filter button {
    position: relative;
    z-index: 1;
    height: 34px;
    padding: 0 16px;
    border: 0;
    background: transparent;
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink-2);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.35s;
  }
  .filter button span { font-size: 11px; opacity: 0.55; }
  .filter button:hover { color: var(--ink); }
  .filter button[aria-pressed="true"] { color: var(--paper); }
  .filter-ink {
    position: absolute;
    top: 4px;
    bottom: 4px;
    border-radius: 999px;
    background: var(--ink);
    transition: left 0.5s var(--ease), width 0.5s var(--ease);
  }

  /* ---------- 时间线 ---------- */
  .timeline { --progress: 0; position: relative; }
  .tl-rail { position: absolute; left: 7px; top: 8px; bottom: 0; width: 1px; background: var(--line); }
  .tl-rail-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }
  .tl-month { display: grid; grid-template-columns: 200px 1fr; gap: 32px; padding-bottom: 72px; }
  .tl-label { position: relative; }
  .tl-label-inner {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 36px;
  }
  .tl-node {
    position: absolute;
    left: 0;
    top: 6px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    background: var(--paper);
    transition: border-color 0.4s, background 0.4s, box-shadow 0.4s;
  }
  .tl-node::after { content: ""; position: absolute; inset: 4px; border-radius: 50%; background: var(--line-2); transition: background 0.4s; }
  .tl-month.is-active .tl-node { border-color: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft); }
  .tl-month.is-active .tl-node::after { background: var(--accent); }
  .tl-year { font-size: 12px; color: var(--ink-3); letter-spacing: 0.18em; }
  .tl-mon { margin: 0; font-size: 34px; line-height: 1.2; font-weight: 600; letter-spacing: 0.1em; transition: color 0.4s; }
  .tl-month:not(.is-active) .tl-mon { color: var(--ink-2); }
  .tl-terms { font-size: 13px; color: var(--ink-2); letter-spacing: 0.24em; }
  .tl-count { font-size: 11px; color: var(--ink-3); margin-top: 10px; letter-spacing: 0.1em; }

  .tl-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .filter-empty { padding: 40px 0 0 232px; }

  .empty { text-align: center; padding: 80px 0; display: grid; justify-items: center; gap: 8px; }
  .empty p { margin: 0; }
  .empty .serif { font-size: 26px; }
  .empty .btn { margin-top: 20px; }

  @media (max-width: 860px) {
    .tl-month { grid-template-columns: 1fr; gap: 20px; padding-bottom: 56px; }
    .tl-label-inner { position: static; flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; }
    .tl-node { top: 50%; transform: translateY(-50%); }
    .tl-mon { font-size: 28px; order: -1; }
    .tl-count { margin: 0; }
    .tl-grid { padding-left: 36px; grid-template-columns: 1fr; }
    .filter-empty { padding-left: 36px; }
    .hero { padding: calc(var(--header-h) + 56px) 0 64px; }
    .hero-stats { gap: 16px 32px; margin-top: 48px; }
  }
  @media (max-width: 560px) {
    .filter { overflow-x: auto; max-width: 100%; }
    .filter button { padding: 0 12px; flex: none; }
  }
</style>
