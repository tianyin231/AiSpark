---
// 展墙：打开就是作品。没有头图，顶栏两行工具条下直接是按月分组的作品墙。
import Base from '../layouts/Base.astro';
import WallToolbar from '../components/WallToolbar.astro';
import WorkCard from '../components/WorkCard.astro';
import MonthHeader from '../components/MonthHeader.astro';
import Minimap from '../components/Minimap.astro';
import { getArtifacts, groupByMonth } from '../lib/archive.js';
import { url } from '../lib/url.js';
import '../styles/wall.css';

const items = getArtifacts();
const groups = groupByMonth(items);
---
<Base nav="wall" section="展墙">
  <WallToolbar slot="tools" items={items} />

  <div class="wall-wrap">
    <h1 class="sr-only">AiSpark 作品展墙</h1>
    {items.length === 0 ? (
      <div class="wall-none">
        <p class="wall-none-title">展墙还空着</p>
        <p>第一件作品，也许就是你的。</p>
        <a class="btn-solid" href={url('/about/')}>看看怎么投稿</a>
      </div>
    ) : (
      <div class="wall" data-wall>
        {groups.map((g) => (
          <Fragment>
            <MonthHeader group={g} />
            {g.items.map((it) => <WorkCard item={it} />)}
          </Fragment>
        ))}
        <p class="wall-empty" data-empty hidden>
          没有符合条件的作品。<button type="button" data-reset>清除全部筛选</button>
        </p>
      </div>
    )}
  </div>

  <script is:inline>
    // 从单间返回时，让作品画面收回到它在墙上的缩略图。
    // 必须在首帧渲染前注册，所以内联在墙的标记之后，而不放进延后执行的模块脚本。
    addEventListener('pagereveal', function (e) {
      var from = e.viewTransition && window.navigation && navigation.activation && navigation.activation.from;
      if (!from || !from.url) return;
      var m = new URL(from.url).pathname.match(/\/artifact\/([^/]+)\/?$/);
      var card = m && document.querySelector('[data-card][data-id="' + CSS.escape(decodeURIComponent(m[1])) + '"]');
      var thumb = card && !card.hidden && card.querySelector('.thumb');
      if (!thumb) return;
      thumb.style.viewTransitionName = 'stage';
      e.viewTransition.finished.finally(function () { thumb.style.viewTransitionName = ''; });
    });
  </script>

  <Minimap />
  <p class="hint" data-hint hidden aria-hidden="true">
    <span><kbd>←↑→↓</kbd>浏览</span><span><kbd>空格</kbd>试玩</span><span><kbd>回车</kbd>打开</span><span><kbd>/</kbd>搜索</span><span><kbd>R</kbd>随便看看</span>
  </p>
</Base>

<script>
  import '../scripts/wall.js';
</script>
