---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.js';
---
<Base title="没有这件作品" section="404">
  <section class="nf">
    <span class="nf-code">404</span>
    <h1>墙上没有这件作品</h1>
    <p>可能还没被创作出来，也可能地址抄错了。</p>
    <div class="nf-acts">
      <a class="btn-solid" href={url('/')}>回到展墙</a>
      <a class="btn" href={url('/about/')}>去投一件</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; display: grid; place-content: center; justify-items: center; gap: 12px; padding: 48px var(--pad-x); text-align: center; }
  .nf-code { padding: 4px 10px; border: 1px solid var(--rule); border-radius: 6px; font: 12px var(--mono); letter-spacing: 0.3em; color: var(--ink-3); }
  .nf h1 { margin: 6px 0 0; font: 700 clamp(24px, 3.6vw, 34px)/1.3 var(--sans); }
  .nf p { margin: 0 0 12px; color: var(--ink-2); }
  .nf-acts { display: flex; gap: 10px; }
</style>
