---
// 作品单间：作品画面占主位并真正运行，署名在右；下方是自述、署名卡与文件。
// 从展墙进入时，墙上的缩略图会放大成这里的作品画面（两边都叫 stage 的页面过渡）。
import Base from '../../layouts/Base.astro';
import { getArtifacts, getArtifact, formatSize } from '../../lib/archive.js';
import { renderMarkdown } from '../../lib/markdown.js';
import { url, rawUrl } from '../../lib/url.js';
import { SITE } from '../../lib/config.js';
import '../../styles/room.css';

export function getStaticPaths() {
  return getArtifacts().map((a) => ({ params: { id: a.id } }));
}

const item = getArtifact(Astro.params.id);
const older = item.prevId ? getArtifact(item.prevId) : null;
const newer = item.nextId ? getArtifact(item.nextId) : null;
const html = renderMarkdown(item.readme, item.relDir, { stripTitle: true });
// 作品画面的 iframe 用 loading="lazy"：等页面布局完成后才加载，作品脚本读到的就是画面的真实尺寸，
// 否则有的作品会按 iframe 默认的 300×150 初始化
const live = item.hasIndex ? rawUrl(item.relDir, 'index.html') : null;
const isArticle = !live && item.type === 'article' && html.trim();
const stageImg = item.cover ? rawUrl(item.relDir, item.cover) : item.images[0] ? rawUrl(item.relDir, item.images[0]) : null;
const gallery = item.type === 'image' || item.type === 'mixed' ? item.images : [];
const pad = (n: number) => String(n).padStart(2, '0');
const when = `${item.date.y}-${pad(item.date.m)}-${pad(item.date.d)}${item.date.time ? ` ${item.date.time}` : ''}`;
const { model, tool, contributor, provider, anonymous } = item.author;
const sign = `${model} · ${tool} · ${contributor}`;
const SAFE_LINK = /\.(md|txt|ya?ml|json|png|jpe?g|gif|webp|avif|csv)$/i; // 只直链不会执行的文件
const totalSize = item.files.reduce((s: number, f: { size: number }) => s + f.size, 0);
---
<Base title={item.title} description={item.description} section="作品">
  <div class="room">
    <div class="room-bar">
      <a class="btn" href={url('/')} data-back>← 展墙</a>
      <span class="room-path">No.{item.no} · artifacts/{item.relDir}/</span>
      <nav class="room-nav" aria-label="相邻作品">
        {newer
          ? <a class="btn" href={url(`/artifact/${newer.id}/`)} data-newer title={`较新：${newer.title}`}>← 较新</a>
          : <span class="btn" aria-disabled="true">← 较新</span>}
        {older
          ? <a class="btn" href={url(`/artifact/${older.id}/`)} data-older title={`较早：${older.title}`}>较早 →</a>
          : <span class="btn" aria-disabled="true">较早 →</span>}
      </nav>
    </div>

    <div class="room-body">
      <div class="room-main">
        <div class:list={['stage', { 'is-article': isArticle, 'is-image': !live && !isArticle && stageImg }]} data-stage data-type={item.type}>
          {live ? (
            <iframe
              src={live}
              loading="lazy"
              title={`${item.title}（作品运行画面）`}
              sandbox="allow-scripts allow-pointer-lock"
              allow="fullscreen"
              referrerpolicy="no-referrer"
            ></iframe>
          ) : isArticle ? (
            <article class="sheet prose">
              <h2 class="sheet-title">{item.title}</h2>
              <Fragment set:html={html} />
            </article>
          ) : stageImg ? (
            <img src={stageImg} alt={item.title} />
          ) : (
            <div class="art" style={`background:${item.art}`}><span>{item.glyph}</span></div>
          )}
        </div>
        {live && (
          <div class="stage-tools">
            <span class="sandbox">在隔离沙箱中运行，无法访问本站数据</span>
            <span class="stage-acts">
              <button type="button" data-reload>↻ 重新运行</button>
              <button type="button" data-full>⤢ 全屏</button>
              <a href={live} target="_blank" rel="noopener">↗ 单独打开</a>
            </span>
          </div>
        )}
        {gallery.length > 1 && (
          <div class="gallery" aria-label="作品图片">
            {gallery.map((src: string) => (
              <a href={rawUrl(item.relDir, src)} data-zoom data-alt={src}>
                <img src={rawUrl(item.relDir, src)} alt={src} loading="lazy" />
              </a>
            ))}
          </div>
        )}
      </div>

      <aside class="info">
        <p class="info-cap"><span class="sq" data-type={item.type}></span>{item.typeLabel} · {when} 入馆</p>
        <h1 class="info-title">{item.title}</h1>
        {item.description && <p class="info-desc">{item.description}</p>}
        <dl class="sig">
          <div><dt>模型名</dt><dd class="lead">{model}</dd></div>
          <div><dt>工具</dt><dd>{tool}</dd></div>
          <div><dt>贡献人</dt><dd class:list={{ anon: anonymous }}>{contributor}</dd></div>
          {provider && <div><dt>模型来源</dt><dd>{provider}</dd></div>}
          {item.seed?.prompt && <div><dt>命题</dt><dd class="plain">{item.seed.prompt}</dd></div>}
          {item.seed?.repo && (
            <div><dt>命题仓库</dt><dd><a class="ext" href={item.seed.repo} target="_blank" rel="noopener noreferrer nofollow">{String(item.seed.repo).replace(/^https?:\/\//, '')}</a></dd></div>
          )}
        </dl>
        {item.tags.length > 0 && <div class="tags">{item.tags.map((t: string) => <span>{t}</span>)}</div>}
        <div class="info-acts">
          <button class="btn" type="button" data-copy data-copy-text={sign}><span data-copy-label>复制署名</span></button>
          <a class="btn" href="#more">署名卡与文件 ↓</a>
        </div>
        <p class="info-keys">← → 切换作品 · Esc 回到展墙</p>
      </aside>
    </div>
  </div>

  <div class:list={['more', { 'is-solo': isArticle || !html.trim() }]} id="more">
    {!isArticle && html.trim() && (
      <section class="more-main">
        <h2 class="more-cap">作品自述 · README.md</h2>
        <div class="prose"><Fragment set:html={html} /></div>
      </section>
    )}
    <div class="more-side">
      <section class="panel">
        <div class="panel-head">
          <h2 class="more-cap">署名卡 · aispark.yaml</h2>
          <button class="link-btn" type="button" data-copy="#yaml-src"><span data-copy-label>复制</span></button>
        </div>
        <pre id="yaml-src"><code>{item.rawYaml}</code></pre>
      </section>
      <section class="panel">
        <div class="panel-head">
          <h2 class="more-cap">文件 · {item.files.length}</h2>
          <span class="more-cap">{formatSize(totalSize)}</span>
        </div>
        <ul class="files">
          {item.files.map((f: { path: string; size: number }) => (
            <li>
              {SAFE_LINK.test(f.path)
                ? <a href={rawUrl(item.relDir, f.path)} target="_blank" rel="noopener">{f.path}</a>
                : <span>{f.path}</span>}
              <span>{formatSize(f.size)}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="panel">
        <h2 class="more-cap">许可</h2>
        <p class="license">以 <a href="https://creativecommons.org/licenses/by/4.0/deed.zh-hans" target="_blank" rel="noopener noreferrer">{SITE.license}</a> 发布。转载请署名：<br /><span>{sign}</span></p>
      </section>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="图片预览">
    <img alt="" />
  </dialog>
</Base>

<script>
  import '../../scripts/room.js';
</script>
