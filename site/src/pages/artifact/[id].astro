---
import Base from '../../layouts/Base.astro';
import { getArtifacts, getArtifact, formatSize } from '../../lib/archive.js';
import { renderMarkdown } from '../../lib/markdown.js';
import { url, rawUrl } from '../../lib/url.js';
import { cnMonth } from '../../lib/calendar.js';
import { SITE } from '../../lib/config.js';

export function getStaticPaths() {
  return getArtifacts().map((a) => ({ params: { id: a.id } }));
}

const item = getArtifact(Astro.params.id);
const prev = item.prevId ? getArtifact(item.prevId) : null;
const next = item.nextId ? getArtifact(item.nextId) : null;
const html = renderMarkdown(item.readme, item.relDir, { stripTitle: true });
const previewSrc = item.hasIndex ? rawUrl(item.relDir, 'index.html') : null;
const gallery = item.type === 'image' || item.type === 'mixed' ? item.images : [];
const pad = (n) => String(n).padStart(2, '0');
const dateText = `${item.date.y} 年 ${cnMonth(item.date.m)} ${item.date.d} 日`;
const SAFE_LINK = /\.(md|txt|ya?ml|json|png|jpe?g|gif|webp|avif|csv)$/i; // 只直链不会执行的文件
---
<Base title={item.title} description={item.description}>
  <article class="wrap detail">
    <nav class="crumbs mono" aria-label="位置">
      <a class="link" href={url('/')}>史书</a>
      <span aria-hidden="true">/</span>
      <span>{item.date.y}.{pad(item.date.m)}</span>
      <span aria-hidden="true">/</span>
      <span class="crumb-cur">No.{item.no}</span>
    </nav>

    <header class="d-head">
      <div class="d-meta" data-reveal>
        <span class="type-tag" data-type={item.type}>{item.typeLabel}</span>
        <span class="mono muted">No.{item.no}</span>
        <time class="mono muted" datetime={item.createdAt}>{dateText}{item.date.time && ` ${item.date.time}`} · {item.date.term}</time>
      </div>
      <h1 class="d-title serif" data-reveal style="--i:1">{item.title}</h1>
      {item.description && <p class="d-desc" data-reveal style="--i:2">{item.description}</p>}
      {item.tags.length > 0 && (
        <ul class="d-tags" data-reveal style="--i:3">
          {item.tags.map((t) => <li class="chip">{t}</li>)}
        </ul>
      )}
    </header>

    <div class="d-body">
      <div class="d-main">
        {previewSrc && (
          <section class="frame" data-frame data-reveal aria-label="作品预览">
            <div class="frame-bar">
              <span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame-url mono">{item.id}/index.html</span>
              <div class="frame-tools">
                <button class="icon-btn" type="button" data-frame-reload aria-label="重新运行">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4" /></svg>
                </button>
                <button class="icon-btn" type="button" data-frame-full aria-label="全屏">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
                </button>
              </div>
            </div>
            <div class="frame-view">
              <!-- 不加 allow-same-origin：作品脚本无法读取主站 Cookie / 存储，也无法操作父页面 -->
              <iframe
                src={previewSrc}
                title={`${item.title} 预览`}
                sandbox="allow-scripts allow-pointer-lock"
                allow="clipboard-write; fullscreen"
                referrerpolicy="no-referrer"
                loading="lazy"
              ></iframe>
            </div>
            <p class="frame-note muted">作品在隔离沙箱中运行，无法访问本站数据。</p>
          </section>
        )}

        {gallery.length > 0 && (
          <section class="gallery" aria-label="图片">
            {gallery.map((src, i) => (
              <a href={rawUrl(item.relDir, src)} data-zoom data-alt={src} data-cursor="放大" data-reveal style={`--i:${i % 4}`}>
                <img src={rawUrl(item.relDir, src)} alt={src} loading="lazy" />
              </a>
            ))}
          </section>
        )}

        {html.trim() && (
          <section class="prose" data-reveal aria-label="作品自述">
            <Fragment set:html={html} />
          </section>
        )}
      </div>

      <aside class="d-side">
        <section class="sign-card" data-reveal data-tilt="4">
          <span class="seal serif" aria-hidden="true">{Array.from(item.author.participant)[0]}</span>
          <span class="eyebrow">署名卡</span>
          <dl class="sign-list">
            <div><dt>参与者</dt><dd class="serif">{item.author.participant}</dd></div>
            <div><dt>模型全称</dt><dd class="mono">{item.author.model}</dd></div>
            <div><dt>模型来源</dt><dd>{item.author.provider}</dd></div>
            <div><dt>入馆时间</dt><dd class="mono">{item.date.y}-{pad(item.date.m)}-{pad(item.date.d)}{item.date.time && ` ${item.date.time}`}</dd></div>
          </dl>
          <details class="yaml">
            <summary>
              <span>查看 aispark.yaml</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="yaml-body">
              <pre id="yaml-src"><code>{item.rawYaml}</code></pre>
              <button class="btn btn--ghost btn--sm" type="button" data-copy="#yaml-src"><span data-copy-label>复制</span></button>
            </div>
          </details>
        </section>

        {item.seed && (item.seed.repo || item.seed.prompt || item.seed.via) && (
          <section class="side-block" data-reveal style="--i:1">
            <span class="eyebrow">创作来源</span>
            <dl class="kv">
              {item.seed.prompt && <div><dt>命题</dt><dd>{item.seed.prompt}</dd></div>}
              {item.seed.via && <div><dt>客户端</dt><dd class="mono">{item.seed.via}</dd></div>}
              {item.seed.repo && (
                <div><dt>仓库</dt><dd><a class="link mono" href={item.seed.repo} target="_blank" rel="noopener noreferrer nofollow">{String(item.seed.repo).replace(/^https?:\/\//, '')}</a></dd></div>
              )}
            </dl>
          </section>
        )}

        <section class="side-block" data-reveal style="--i:2">
          <span class="eyebrow">文件 · {item.files.length}</span>
          <ul class="files mono">
            {item.files.map((f) => (
              <li>
                {SAFE_LINK.test(f.path)
                  ? <a class="link" href={rawUrl(item.relDir, f.path)} target="_blank" rel="noopener">{f.path}</a>
                  : <span>{f.path}</span>}
                <span class="muted">{formatSize(f.size)}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="side-block license" data-reveal style="--i:3">
          <span class="eyebrow">许可</span>
          <p>以 <a class="link" href="https://creativecommons.org/licenses/by/4.0/deed.zh-hans" target="_blank" rel="noopener noreferrer">{SITE.license}</a> 发布。转载请署名：<br /><span class="mono">{item.author.participant} · {item.author.model} · {item.author.provider}</span></p>
        </section>
      </aside>
    </div>

    <nav class="pager" aria-label="相邻作品">
      {prev ? (
        <a class="pager-item" href={url(`/artifact/${prev.id}/`)} data-tilt="4">
          <span class="eyebrow">较早 · No.{prev.no}</span>
          <span class="pager-title serif">{prev.title}</span>
          <span class="mono muted">{prev.author.model}</span>
        </a>
      ) : <span class="pager-item is-empty"><span class="eyebrow">较早</span><span class="muted">这是第一件入馆作品</span></span>}
      {next ? (
        <a class="pager-item is-next" href={url(`/artifact/${next.id}/`)} data-tilt="4">
          <span class="eyebrow">较新 · No.{next.no}</span>
          <span class="pager-title serif">{next.title}</span>
          <span class="mono muted">{next.author.model}</span>
        </a>
      ) : <span class="pager-item is-next is-empty"><span class="eyebrow">较新</span><span class="muted">这是最新入馆的作品</span></span>}
    </nav>
  </article>

  <dialog class="lightbox" data-lightbox aria-label="图片预览">
    <img alt="" />
  </dialog>
</Base>

<style>
  .detail { padding-top: 40px; }
  .crumbs { display: flex; gap: 10px; font-size: 12px; color: var(--ink-3); letter-spacing: 0.06em; }
  .crumb-cur { color: var(--ink); }

  .d-head { padding: 48px 0 40px; border-bottom: 1px solid var(--line); margin-bottom: 40px; max-width: 860px; }
  .d-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; font-size: 12px; }
  .d-title { margin: 20px 0 0; font-size: clamp(34px, 5vw, 58px); line-height: 1.2; font-weight: 600; letter-spacing: 0.03em; }
  .d-desc { margin: 20px 0 0; font-size: 17px; color: var(--ink-2); line-height: 1.85; max-width: 680px; }
  .d-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 24px 0 0; }

  .d-body { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 48px; align-items: start; }
  .d-main { display: flex; flex-direction: column; gap: 48px; min-width: 0; }
  .d-side { position: sticky; top: calc(var(--header-h) + 24px); display: flex; flex-direction: column; gap: 20px; }
  @media (max-width: 960px) {
    .d-body { grid-template-columns: 1fr; }
    .d-side { position: static; }
  }

  /* ---------- 预览框 ---------- */
  .frame { border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); overflow: hidden; box-shadow: var(--shadow); }
  .frame-bar { display: flex; align-items: center; gap: 14px; height: 46px; padding: 0 8px 0 16px; border-bottom: 1px solid var(--line); }
  .frame-dots { display: flex; gap: 6px; }
  .frame-dots i { width: 10px; height: 10px; border-radius: 50%; border: 1px solid var(--line-2); transition: background 0.3s; }
  .frame:hover .frame-dots i:nth-child(1) { background: var(--accent); border-color: var(--accent); }
  .frame-url { flex: 1; font-size: 12px; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .frame-tools { display: flex; gap: 2px; }
  .frame-view { position: relative; aspect-ratio: 16 / 10; background: var(--paper-2); }
  .frame-view iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; transition: opacity 0.4s; }
  .frame.is-loading iframe { opacity: 0.3; }
  .frame-note { margin: 0; padding: 10px 16px; font-size: 12px; border-top: 1px solid var(--line); }
  .frame:fullscreen { border-radius: 0; display: flex; flex-direction: column; }
  .frame:fullscreen .frame-view { flex: 1; aspect-ratio: auto; }
  @media (max-width: 640px) { .frame-view { aspect-ratio: 3 / 4; } }

  /* ---------- 画廊 ---------- */
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .gallery a { border-radius: 10px; overflow: hidden; border: 1px solid var(--line); background: var(--paper-2); aspect-ratio: 1; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .gallery a:hover img { transform: scale(1.06); }

  .lightbox { border: 0; padding: 0; background: transparent; max-width: 92vw; max-height: 92vh; }
  .lightbox::backdrop { background: rgba(10, 9, 8, 0.82); backdrop-filter: blur(6px); }
  .lightbox img { max-width: 92vw; max-height: 92vh; border-radius: 8px; }
  .lightbox[open] { animation: page-in 0.4s var(--ease); }

  /* ---------- 正文 ---------- */
  .prose { max-width: 720px; font-size: 16px; line-height: 1.95; color: var(--ink); }
  .prose :global(h2) { font: 600 24px/1.4 var(--serif); margin: 2.2em 0 0.7em; letter-spacing: 0.04em; }
  .prose :global(h3) { font: 600 19px/1.4 var(--serif); margin: 1.8em 0 0.5em; }
  .prose :global(p) { margin: 0 0 1.2em; }
  .prose > :global(p:first-child) { font-size: 18px; }
  .prose :global(a) { color: var(--accent); background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; transition: background-size 0.4s var(--ease); }
  .prose :global(a:hover) { background-size: 0 1px; background-position: 100% 100%; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; margin: 0 0 1.2em; }
  .prose :global(li) { margin: 0.3em 0; }
  .prose :global(li::marker) { color: var(--ink-3); }
  .prose :global(code) { font: 0.88em var(--mono); background: var(--paper-2); border: 1px solid var(--line); padding: 1px 6px; border-radius: 4px; }
  .prose :global(pre) { background: var(--paper-2); border: 1px solid var(--line); padding: 16px 18px; border-radius: 10px; overflow: auto; font-size: 13px; line-height: 1.7; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(blockquote) { margin: 1.6em 0; padding: 4px 0 4px 20px; border-left: 2px solid var(--accent); color: var(--ink-2); font-family: var(--serif); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(img) { border-radius: 10px; border: 1px solid var(--line); margin: 1.4em 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 14px; margin: 0 0 1.4em; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--line); padding: 8px 10px; text-align: left; }

  /* ---------- 署名卡 ---------- */
  .sign-card {
    --rx: 0deg; --ry: 0deg;
    position: relative;
    padding: 24px 22px 18px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.7s var(--ease), box-shadow 0.4s;
  }
  .sign-card.is-tilting { transition: transform 0.12s linear, box-shadow 0.4s; }
  .sign-card:hover { box-shadow: var(--shadow-lift); }
  .seal {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    border-radius: 6px;
    font-size: 22px;
    transform: rotate(-6deg);
    box-shadow: inset 0 0 0 3px var(--card), inset 0 0 0 4px var(--accent);
    transition: transform 0.6s var(--ease);
  }
  .sign-card:hover .seal { transform: rotate(4deg) scale(1.06); }
  .sign-list { margin: 20px 0 0; display: grid; gap: 14px; }
  .sign-list div { display: grid; gap: 2px; }
  .sign-list dt, .kv dt { font-size: 11px; color: var(--ink-3); letter-spacing: 0.12em; }
  .sign-list dd { margin: 0; font-size: 15px; word-break: break-word; }
  .sign-list dd.serif { font-size: 20px; font-weight: 600; }

  .yaml { margin-top: 18px; border-top: 1px dashed var(--line); padding-top: 12px; }
  .yaml summary { list-style: none; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-size: 13px; color: var(--ink-2); transition: color 0.3s; }
  .yaml summary::-webkit-details-marker { display: none; }
  .yaml summary:hover { color: var(--ink); }
  .yaml summary svg { width: 16px; height: 16px; transition: transform 0.4s var(--ease); }
  .yaml[open] summary svg { transform: rotate(180deg); }
  .yaml-body { margin-top: 12px; display: grid; gap: 10px; justify-items: start; animation: page-in 0.4s var(--ease); }
  .yaml pre { margin: 0; width: 100%; max-height: 300px; overflow: auto; background: var(--paper-2); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; font: 11.5px/1.65 var(--mono); }

  .side-block { padding: 18px 22px; border-radius: var(--radius); border: 1px solid var(--line); }
  .kv { margin: 14px 0 0; display: grid; gap: 12px; }
  .kv div { display: grid; gap: 2px; }
  .kv dd { margin: 0; font-size: 14px; word-break: break-all; }
  .files { list-style: none; margin: 14px 0 0; padding: 0; font-size: 12px; display: grid; gap: 8px; }
  .files li { display: flex; justify-content: space-between; gap: 12px; }
  .files li > :first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .files li > .muted { flex: none; }
  .license p { margin: 12px 0 0; font-size: 13px; color: var(--ink-2); line-height: 1.8; }
  .license .mono { font-size: 12px; color: var(--ink); }

  /* ---------- 翻页 ---------- */
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 96px; padding-top: 40px; border-top: 1px solid var(--line); }
  .pager-item {
    --rx: 0deg; --ry: 0deg;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 26px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.7s var(--ease), border-color 0.4s, box-shadow 0.4s;
  }
  .pager-item.is-tilting { transition: transform 0.12s linear, border-color 0.4s, box-shadow 0.4s; }
  a.pager-item:hover { border-color: var(--ink-3); box-shadow: var(--shadow-lift); }
  .pager-item.is-next { text-align: right; align-items: flex-end; }
  .pager-item.is-next .eyebrow { flex-direction: row-reverse; }
  .pager-item.is-empty { background: transparent; border-style: dashed; font-size: 13px; }
  .pager-title { font-size: 22px; font-weight: 600; }
  .pager-item .mono { font-size: 12px; }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } .pager-item.is-next { text-align: left; align-items: flex-start; } .pager-item.is-next .eyebrow { flex-direction: row; } }
</style>
