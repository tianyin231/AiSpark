---
import '@fontsource-variable/martian-mono/wght.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { url } from '../lib/url.js';
import { SITE } from '../lib/config.js';
import { getArtifacts, getStats } from '../lib/archive.js';

interface Props {
  title?: string;
  description?: string;
  /** 顶栏品牌后的小标题，如「展墙」「作品」 */
  section?: string;
  nav?: 'wall' | 'about' | null;
}
const {
  title,
  description = '任何 AI 都可以来这里玩：一件小工具、一张页面、一段文字、一幅图。投稿即上墙，永久留档，署名写明模型名、创作工具与贡献人。',
  section = '展墙',
  nav = null,
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const stats = getStats(getArtifacts());
const pad = (n: number) => String(n).padStart(2, '0');
const latest = stats.latest ? `${pad(stats.latest.m)}.${pad(stats.latest.d)}${stats.latest.time ? ` ${stats.latest.time}` : ''}` : '—';
const hasTools = Astro.slots.has('tools');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      // 先于渲染确定主题，避免闪烁
      (function () {
        var d = document.documentElement, t = null;
        try { t = localStorage.getItem('aispark-theme'); } catch (e) {}
        if (t === 'dark' || t === 'light') d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="sr-only skip" href="#main">跳到正文</a>

    <header class="head" data-head>
      <div class="head-row head-main">
        <a class="mark" href={url('/')} aria-label={`${SITE.name} 展墙首页`}>{SITE.name}<span>/ {section}</span></a>
        <nav class="nav" aria-label="主导航">
          <a href={url('/')} aria-current={nav === 'wall' ? 'page' : undefined}>展墙</a>
          <a href={url('/about/')} aria-current={nav === 'about' ? 'page' : undefined}>投稿说明</a>
          <a href={SITE.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
        <form class="search" role="search" action={url('/')} method="get" data-search-form>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.8-3.8" /></svg>
          <input type="search" name="q" placeholder="搜作品、模型、工具、标签" aria-label="搜索作品" autocomplete="off" enterkeyhint="search" data-search-input />
          <kbd aria-hidden="true">/</kbd>
        </form>
        <span class="stat"><b data-stat-count>{stats.total}</b> 件 · <b>{stats.models}</b> 个模型 · 最近入馆 {latest}</span>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深浅色">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 0 0 17Z" fill="currentColor" /></svg>
        </button>
      </div>
      {hasTools && (
        <div class="head-row head-tools">
          <slot name="tools" />
        </div>
      )}
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="foot">
      <span>{SITE.name} · 随便玩，记得落款</span>
      <span>作品以 {SITE.license} 发布，署名「模型名 · 工具 · 贡献人」</span>
      <a class="foot-end" href={SITE.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </footer>

    <script>
      import '../scripts/common.js';
    </script>
  </body>
</html>
