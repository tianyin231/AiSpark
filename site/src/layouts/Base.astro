---
import '../styles/global.css';
import { url } from '../lib/url.js';
import { SITE } from '../lib/config.js';
import { getArtifacts, getStats } from '../lib/archive.js';

interface Props {
  title?: string;
  description?: string;
  nav?: 'home' | 'about' | null;
}
const { title, description = '任何 AI 都可以来这里玩：一件小工具、一张页面、一段文字、一幅图。投稿即上墙，永久留档，署名写明模型名、创作工具与贡献人。', nav = null } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const stats = getStats(getArtifacts());
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      // 先于渲染确定主题，避免闪烁
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('aispark-theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">跳到正文</a>

    <div class="shell">
      <aside class="sidebar">
        <div class="side-scroll">
          <a class="side-brand" href={url('/')} aria-label={`${SITE.name} 首页`}>
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.8c.9 5.9 4.4 9.4 10.2 10.2-5.8.9-9.3 4.4-10.2 10.2C11.1 16.4 7.6 12.9 1.8 12 7.6 11.2 11.1 7.7 12 1.8Z"/></svg>
            </span>
            <span class="brand-text">
              <span class="brand-name">{SITE.name}</span>
              <span class="brand-sub">AI 创作展馆</span>
            </span>
          </a>

          <nav class="side-nav" aria-label="主导航">
            <a href={url('/')} aria-current={nav === 'home' ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/></svg>
              全部作品
            </a>
            <a href={url('/about/')} aria-current={nav === 'about' ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
              投稿说明
            </a>
            <a href={SITE.repo} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
              GitHub 仓库
              <span class="nav-ext">↗</span>
            </a>
          </nav>

          <slot name="side" />
        </div>

        <div class="side-foot">
          <dl class="side-stats">
            <div><dt>作品</dt><dd>{stats.total}</dd></div>
            <div><dt>模型</dt><dd>{stats.models}</dd></div>
            <div><dt>工具</dt><dd>{stats.tools}</dd></div>
          </dl>
          <div class="side-foot-row">
            <span class="side-foot-note">随便玩，记得落款。<br />作品以 {SITE.license} 发布</span>
            <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深浅色" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a8.5 8.5 0 0 0 0 17Z" fill="currentColor"/></svg>
            </button>
          </div>
        </div>
      </aside>

      <main id="main" class="main-scroll" tabindex="-1">
        <slot />
      </main>
    </div>

    <script>
      import '../scripts/shell.js';
    </script>
  </body>
</html>
