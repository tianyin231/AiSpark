---
import { url, rawUrl } from '../lib/url.js';

const { item } = Astro.props;
const href = url(`/artifact/${item.id}/`);
const lead = item.type === 'article' && item.excerpt ? item.excerpt : item.description;
const searchText = [
  item.title, item.description, item.author.model, item.author.tool,
  item.author.contributor, ...(item.tags || []),
].join(' ').toLowerCase();
const pad = (n) => String(n).padStart(2, '0');
// 前端类作品且无封面图时，用实时缩放预览当封面
const livePreview = item.hasIndex && !item.cover;
const previewImg = item.cover || (item.type === 'image' ? item.images[0] : null);
---
<article
  class="card"
  data-card
  data-type={item.type}
  data-model={item.author.model}
  data-ts={item.date.ts}
  data-search={searchText}
>
  <a class="card-link" href={href} aria-label={`${item.title}，${item.author.model} · ${item.author.tool} · ${item.author.contributor}`}>
    <div class="card-preview" data-type={item.type}>
      {livePreview ? (
        <div class="pv-live" aria-hidden="true">
          <iframe
            src={rawUrl(item.relDir, 'index.html')}
            title=""
            tabindex="-1"
            sandbox="allow-scripts"
            referrerpolicy="no-referrer"
            loading="lazy"
          ></iframe>
        </div>
      ) : previewImg ? (
        <img src={rawUrl(item.relDir, previewImg)} alt="" loading="lazy" />
      ) : item.type === 'article' ? (
        <div class="pv-text" aria-hidden="true">
          <span class="pv-text-body">{item.excerpt || item.description}</span>
        </div>
      ) : (
        <div class="pv-glyph" aria-hidden="true">{item.glyph}</div>
      )}
      <span class="card-no mono">No.{item.no}</span>
    </div>

    <div class="card-body">
      <div class="card-top">
        <span class="card-top-left">
          <span class="type-tag" data-type={item.type}>{item.typeLabel}</span>
          {item.tags.length > 0 && <span class="chip">{item.tags[0]}</span>}
        </span>
        <time class="mono" datetime={item.createdAt}>{item.date.y}.{pad(item.date.m)}.{pad(item.date.d)}</time>
      </div>
      <h3 class="card-title">{item.title}</h3>
      {lead && <p class="card-desc">{lead}</p>}
      <div class="card-foot">
        <span class="card-sign mono" title="模型名 · 工具 · 贡献人">
          <b>{item.author.model}</b><i>·</i>{item.author.tool}<i>·</i><span class:list={{ 'is-anon': item.author.anonymous }}>{item.author.contributor}</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .card { min-width: 0; }
  .card.is-hidden { display: none; }

  .card-link {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    height: 150px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: border-color 0.25s, box-shadow 0.3s, transform 0.3s var(--ease);
  }
  .card-link:hover {
    border-color: var(--line-2);
    box-shadow: var(--shadow-lift);
    transform: translateY(-1px);
  }

  /* ---------- 预览 ---------- */
  .card-preview {
    position: relative;
    overflow: hidden;
    background: var(--paper-2);
    border-right: 1px solid var(--line);
  }
  .card-preview img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .pv-live { position: absolute; inset: 0; overflow: hidden; background: #fff; }
  .pv-live iframe {
    width: 704px; height: 600px;
    border: 0;
    transform: scale(0.25);
    transform-origin: 0 0;
    pointer-events: none;
  }
  .pv-text {
    position: absolute; inset: 0;
    padding: 14px 16px;
    border-left: 3px solid var(--tc, var(--line-2));
    overflow: hidden;
  }
  .pv-text-body {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .pv-glyph {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    font-size: 52px; font-weight: 600;
    color: color-mix(in srgb, var(--tc, var(--ink-3)) 55%, var(--ink-3));
  }
  .card-no {
    position: absolute;
    left: 10px; bottom: 10px;
    font-size: 10.5px; letter-spacing: 0.08em;
    color: var(--ink-2);
    background: color-mix(in srgb, var(--card) 88%, transparent);
    padding: 2px 7px;
    border-radius: 5px;
    backdrop-filter: blur(4px);
  }

  /* ---------- 文案 ---------- */
  .card-body {
    display: flex; flex-direction: column;
    gap: 5px;
    padding: 13px 16px 12px;
    min-width: 0;
  }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .card-top-left { display: inline-flex; align-items: center; gap: 9px; min-width: 0; }
  .card-top time { font-size: 11.5px; color: var(--ink-3); }
  .card-title {
    margin: 1px 0 0;
    font-size: 16.5px; font-weight: 650; line-height: 1.35; letter-spacing: 0.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .card-link:hover .card-title { color: var(--accent); }
  .card-desc {
    margin: 0;
    font-size: 13px; line-height: 1.65; color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-foot {
    margin-top: auto;
    padding-top: 8px;
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
  }
  .card-sign {
    font-size: 11.5px; color: var(--ink-3);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    min-width: 0;
  }
  .card-sign b { color: var(--ink); font-weight: 550; }
  .card-sign i { font-style: normal; opacity: 0.5; margin: 0 5px; }
  .card-sign .is-anon { font-style: italic; opacity: 0.75; }

  @media (max-width: 560px) {
    .card-link { grid-template-columns: 128px minmax(0, 1fr); height: auto; min-height: 150px; }
    .pv-live iframe { width: 512px; height: 600px; }
    .card-sign { white-space: normal; line-height: 1.55; }
  }
</style>
