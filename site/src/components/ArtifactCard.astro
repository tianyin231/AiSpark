---
import { url, rawUrl } from '../lib/url.js';

const { item, index = 0 } = Astro.props;
const href = url(`/artifact/${item.id}/`);
const lead = item.type === 'article' && item.excerpt ? item.excerpt : item.description;
---
<article class="card-wrap" data-card data-type={item.type} data-reveal style={`--i:${index % 6}`}>
  <a class="card" href={href} data-tilt="7" data-cursor="查看" aria-label={`${item.title}，${item.author.model} · ${item.author.tool} · ${item.author.contributor}`}>
    <div class="card-cover" data-type={item.type}>
      {item.cover ? (
        <img src={rawUrl(item.relDir, item.cover)} alt="" loading="lazy" />
      ) : (
        <span class="card-glyph" aria-hidden="true">{item.glyph}</span>
      )}
      <span class="card-no mono">No.{item.no}</span>
      <span class="card-spot" aria-hidden="true"></span>
    </div>
    <div class="card-body">
      <div class="card-meta">
        <span class="type-tag" data-type={item.type}>{item.typeLabel}</span>
        <time class="mono" datetime={item.createdAt}>{String(item.date.m).padStart(2, '0')}.{String(item.date.d).padStart(2, '0')} · {item.date.term}</time>
      </div>
      <h3 class="card-title serif">{item.title}</h3>
      {lead && <p class="card-desc">{lead}</p>}
      <div class="card-sign mono" title="模型名 · 工具 · 贡献人">
        <span class="sign-name">{item.author.model}</span>
        <span class="sign-sep">/</span>
        <span>{item.author.tool}</span>
        <span class="sign-sep">/</span>
        <span class:list={{ 'sign-anon': item.author.anonymous }}>{item.author.contributor}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card-wrap { perspective: 1100px; transition: opacity 0.5s var(--ease), transform 0.9s var(--ease), filter 0.5s; }
  .card-wrap.is-filtered { opacity: 0.12; filter: grayscale(1); pointer-events: none; }

  .card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(0);
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease), box-shadow 0.5s var(--ease), border-color 0.4s;
    will-change: transform;
  }
  .card:hover { box-shadow: var(--shadow-lift); border-color: var(--line-2); transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(-6px); }
  .card.is-tilting { transition: transform 0.12s linear, box-shadow 0.5s var(--ease), border-color 0.4s; }
  .card::after {
    /* 跟随指针的柔光 */
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--ink) 6%, transparent), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:hover::after { opacity: 1; }

  .card-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }
  /* 按类型给封面不同的纸纹 */
  .card-cover[data-type="frontend"] { background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 22px 22px; }
  .card-cover[data-type="tool"] { background-image: radial-gradient(var(--line-2) 1.2px, transparent 1.4px); background-size: 16px 16px; }
  .card-cover[data-type="article"] { background-image: linear-gradient(transparent 27px, var(--line) 28px); background-size: 100% 28px; }
  .card-cover[data-type="image"] { background-image: repeating-linear-gradient(45deg, var(--line) 0 1px, transparent 1px 14px); }
  .card-cover[data-type="mixed"], .card-cover[data-type="other"] { background-image: repeating-linear-gradient(-45deg, var(--line) 0 1px, transparent 1px 12px), repeating-linear-gradient(45deg, var(--line) 0 1px, transparent 1px 12px); }

  .card-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .card:hover .card-cover img { transform: scale(1.05); }

  .card-glyph {
    font: 400 clamp(64px, 9vw, 104px)/1 var(--serif);
    color: var(--ink);
    transform: translate(calc((var(--mx) - 50%) * -0.08), calc((var(--my) - 50%) * -0.08));
    transition: transform 0.6s var(--ease), color 0.4s;
    text-shadow: 0 1px 0 var(--paper);
  }
  .card:hover .card-glyph { color: var(--tc); }
  .card-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx) var(--my), color-mix(in srgb, var(--tc) 16%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:hover .card-spot { opacity: 1; }
  .card-no {
    position: absolute;
    top: 14px;
    left: 16px;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-3);
    background: color-mix(in srgb, var(--card) 80%, transparent);
    padding: 3px 7px;
    border-radius: 4px;
  }

  .card-body { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 20px; flex: 1; }
  .card-meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .card-meta time { font-size: 11.5px; color: var(--ink-3); letter-spacing: 0.06em; }
  .card-title {
    margin: 4px 0 0;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.02em;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1px no-repeat;
    transition: background-size 0.6s var(--ease);
    align-self: flex-start;
  }
  .card:hover .card-title { background-size: 100% 1px; }
  .card-desc {
    margin: 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-sign {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    font-size: 11.5px;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .sign-name { color: var(--ink); font-weight: 500; }
  .sign-sep { opacity: 0.5; }
  .sign-anon { font-style: italic; opacity: 0.7; }
</style>
